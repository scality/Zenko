{
    "compilerOptions": {
        "target": "ES2019",
        "module": "commonjs",
        "allowJs": false,
        "sourceMap": true,
        "noEmit": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "skipLibCheck": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "baseUrl": "./",
        "paths": {
            "clients/*": ["./clients/*"],
            "common/*": ["./ctst/common/*"],
            "steps/*": ["./ctst/steps/*"],
            "world/*": ["./ctst/world/*"]
        },
        "esModuleInterop": true
    },
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "module": "commonjs"
        }
    },
    "include": [
        "clients/**/*",
        "ctst/**/*",
        "testResourcesSetup/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
